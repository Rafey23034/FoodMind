{
  "name": "foodmind",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start --workspace @foodmind/mobile",
    "android": "npm run android --workspace @foodmind/mobile",
    "android:setup": "npm run android:setup --workspace @foodmind/mobile",
    "web": "npm run web --workspace @foodmind/mobile",
    "test": "npm run test --workspace @foodmind/mobile",
    "check": "npm run check --workspace @foodmind/mobile",
    "api": "npm run start --workspace @foodmind/api",
    "api:smoke": "npm run smoke --workspace @foodmind/api",
    "api:test-db": "powershell -ExecutionPolicy Bypass -File database/reset_test_db.ps1",
    "ai:server": "npm run start --workspace @foodmind/api"
  }
}
